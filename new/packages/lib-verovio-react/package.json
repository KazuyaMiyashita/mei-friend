{
  "name": "@mei-friend/lib-verovio-react",
  "version": "0.1.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --dry",
    "clean": "tsc -b --clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:e2e": "playwright test -c e2e",
    "test:e2e:ui": "playwright test -c e2e --ui",
    "test:sandbox": "vite e2e/sandbox --port 5180",
    "test:generate-test-fixture": "vite-node scripts/generate-test-fixture.ts"
  },
  "dependencies": {
    "@mei-friend/core": "*",
    "comlink": "^4.4.2",
    "verovio": "^6.1.0"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@types/node": "^24.12.2",
    "@vitest/browser": "^4.1.4",
    "@vitest/browser-playwright": "^4.1.4",
    "vite": "^8.0.8",
    "vite-node": "^6.0.0"
  }
}
