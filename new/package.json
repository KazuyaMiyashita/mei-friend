{
  "name": "mei-friend-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "build": "npm run lint && npm run build-only",
    "build-only": "tsc --build",
    "build-skiplint": "npm run build-only",
    "lint": "biome check .",
    "format": "biome format --write .",
    "type-check": "tsc --build --dry",
    "test": "vitest run"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "typescript": "^6.0.2",
    "vitest": "^4.1.4"
  }
}
