{
  "name": "mei-friend-monorepo",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "dev": "npm run dev --workspace=@mei-friend/web-app",
    "dev:codemirror": "npm run dev --workspace=@mei-friend/example-web-app-codemirror",
    "dev:verovio": "npm run dev --workspace=@mei-friend/example-web-app-verovio",
    "dev:verovio-codemirror": "npm run dev --workspace=@mei-friend/example-web-app-verovio-codemirror",
    "build": "npm run lint && npm run build:libs && npm run build:apps",
    "build:libs": "tsc -b packages/core packages/lib-codemirror packages/lib-verovio-react packages/example-cli",
    "build:apps": "npm run build --workspace=@mei-friend/web-app --workspace=@mei-friend/example-web-app-codemirror --workspace=@mei-friend/example-web-app-verovio --workspace=@mei-friend/example-web-app-verovio-codemirror",
    "build-skiplint": "npm run build:libs && npm run build:apps",
    "typecheck": "tsc -b --dry",
    "clean": "tsc -b --clean && npm run clean --ws",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:e2e:ui": "npm run test:e2e:ui --workspaces --if-present",
    "preview": "npm run preview --workspace=@mei-friend/web-app"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "typescript": "^6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
