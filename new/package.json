{
  "name": "mei-friend-monorepo",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "scripts": {
    "dev": "turbo run dev --filter=@mei-friend/web-app",
    "dev:codemirror": "turbo run dev --filter=@mei-friend/example-web-app-codemirror",
    "dev:verovio": "turbo run dev --filter=@mei-friend/example-web-app-verovio",
    "dev:verovio-codemirror": "turbo run dev --filter=@mei-friend/example-web-app-verovio-codemirror",
    "build": "pnpm lint && turbo run build",
    "build:libs": "turbo run build --filter=@mei-friend/core --filter=@mei-friend/lib-codemirror --filter=@mei-friend/lib-verovio-react --filter=@mei-friend/example-cli",
    "build-skiplint": "turbo run build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "test:e2e:ui": "turbo run test:e2e:ui",
    "preview": "turbo run preview --filter=@mei-friend/web-app",
    "start:cli": "turbo run start --filter=@mei-friend/example-cli"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.12",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "jsdom": "^29.0.2",
    "turbo": "^2.9.6",
    "typescript": "^6.0.2",
    "vite": "^8.0.4",
    "vitest": "^4.1.4"
  }
}
